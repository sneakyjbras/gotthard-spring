# Java / Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Node
node_modules/
dist/

# Local config — never commit credentials
.env
*.local

# Filled-in Kubernetes secret (use secrets/secret.example.yaml as the template)
secrets/secret.yaml
**/secret.yaml

# scripts/kind-up.sh's own kubeconfig for the local kind cluster — kept
# out of ~/.kube/config on purpose (that one's current-context points at a
# real cluster; see argocd/README.md).
.kube/

# Editors
.idea/
*.iml
.vscode/

# Agent worktrees and local Claude state
.claude/
