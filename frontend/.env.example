# Copy to .env.local (gitignored — see .gitignore's "*.local") to override.
#
# Unset, or any value other than "mock", binds the operator console to the
# real backend at http://localhost:8080 (via the dev proxy in
# vite.config.ts) — that is the default, so `npm run dev` needs the backend
# running (`./start.sh` from the repo root).
#
# Set to "mock" to review the UI with no backend at all, against the fixed
# dataset in src/lib/api/mock-data.ts.
VITE_API_MODE=real
